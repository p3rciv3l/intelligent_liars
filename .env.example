# Required for OpenRouter LLM judging
OPENROUTER_API_KEY=

# Optional if Hugging Face model download requires authentication
# HF_TOKEN=

# OSWorld cloud preflight gates. Values are read only at runtime and never
# included in dry-run output.
VAST_API_KEY=
VASTAI_PATH=
# Prefer an attached controller IAM role. These are bootstrap-only alternatives.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_REGION=
QWEN_ENDPOINT_URL=
QWEN_ENDPOINT_API_KEY=
OSWORLD_ARTIFACT_DESTINATION=
